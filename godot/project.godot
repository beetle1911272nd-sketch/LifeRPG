; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="ABORE LIFE RPG"
config/icon="res://pwa-icon-512.png"
boot_splash/image="res://pwa-icon-512.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
boot_splash/show_image=true
run/main_scene="res://scenes/main/title_screen.tscn"
config/features=PackedStringArray("4.7")

[gui]

theme/custom="res://ui/abore_theme.tres"

[autoload]

GameManager="*res://scripts/systems/game_manager.gd"
GameSync="*res://scripts/systems/game_sync.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[physics]

common/physics_interpolation=true

[rendering]

anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.05, 0.07, 0.14, 1)
